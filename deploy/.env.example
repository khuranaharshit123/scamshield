# Copy to deploy/.env on the VPS (chmod 600). Never commit the real file.
APP_ENV=production
GHCR_OWNER=your-github-username
API_KEY=change-me-long-random          # also baked into the APK (scamshield.apiKey)
ADMIN_PASSWORD=change-me-long-random   # /admin/* basic auth, user "admin"
DB_PASSWORD=change-me-long-random
DATABASE_URL=postgresql+asyncpg://scam:SAME_AS_DB_PASSWORD@postgres:5432/scamshield   
FERNET_KEY=                            # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PUBLIC_BASE_URL=https://api.yourdomain.in

DEEP_SCAN_ENABLED=true
SANDBOX_ENABLED=true

REPORT_MODE=demo                       # demo | live  (live only after verifying backend/data/authorities.yaml)
REPORTS_ENABLED=true
DEMO_RECIPIENTS=reports-demo@yourdomain.in
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=reports@yourdomain.in
SMTP_PASSWORD=change-me
MAIL_FROM=ScamShield Reports <reports@yourdomain.in>
MAIL_REPLY_TO=ops@yourdomain.in

ABUSECH_AUTH_KEY=                      # https://auth.abuse.ch (URLhaus + ThreatFox)
GOOGLE_SAFEBROWSING_KEY=
